[Unit]
Description=RB Assistant local semantic search service
After=network.target

[Service]
Type=simple
User=rbassistant
WorkingDirectory=/opt/rb-assistant
Environment=PYTHONPATH=/opt/rb-assistant
ExecStart=/opt/rb-assistant/venv/bin/python3 /opt/rb-assistant/server.py --port 9001
Restart=on-failure

[Install]
WantedBy=multi-user.target
